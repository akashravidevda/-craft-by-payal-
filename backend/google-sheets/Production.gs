    else{quote=cbpQuote_(o).quote;if(!Number.isSafeInteger(body.quoteExpires)||body.quoteExpires<Date.now()||body.quoteExpires>Date.now()+16*60000||body.quoteToken!==cbpHash_(cbpProps_().getProperty('CBP_TOKEN_SECRET')+':quote:'+body.quoteFingerprint+':'+body.quoteExpires))cbpError_('QUOTE_EXPIRED','Your quote expired. Review prices again.');if(body.quoteFingerprint!==quote.fingerprint)cbpError_('QUOTE_CHANGED','Prices or availability changed. Review the updated quote.');var recent=cbpRows_('Shop Orders').filter(function(r){return r.Email===o.customer.email&&Date.now()-new Date(r['Created at']).getTime()<3600000;});if(recent.length>=5)cbpError_('RATE_LIMIT','Too many recent orders for this email. Contact the studio.');var access=cbpHash_(cbpToken_(body.requestId,'track')),upload='';var payload={order:o,quote:quote,accessHash:access,uploadHash:upload};if(JSON.stringify(payload).length>40000)cbpError_('VALIDATION','Order details are too long. Shorten personalisation notes.');cbpAppend_('Shop Operations',[{'Request ID':body.requestId,Fingerprint:fingerprint,State:'Pending','Order ID':cbpId_(),Payload:JSON.stringify(payload),'Updated at':new Date()}]);op=cbpRows_('Shop Operations').find(function(r){return r['Request ID']===body.requestId;});}
    var data=JSON.parse(op.Payload),order=op.State==='Complete'?cbpRows_('Shop Orders').find(function(o){return o['Order ID']===op['Order ID'];}):cbpRecordOrder_(op,data.order,data.quote,data.accessHash,data.uploadHash);if(!order)cbpError_('RECOVERY_REQUIRED','The order needs studio review before retrying.');
    return {ok:true,schema:2,id:order['Order number'],orderId:order['Order ID'],quote:quote,accessToken:cbpToken_(body.requestId,'track'),status:order['Order status']};
  });
}
function cbpAccessOrder_(id,token,upload){var order=cbpRows_('Shop Orders').find(function(r){return r['Order ID']===id;});if(!order||typeof token!=='string'||cbpHash_(token)!==order[upload?'Upload hash':'Access hash'])cbpError_('NOT_FOUND','Order access could not be verified.');if(upload&&(new Date(order['Upload expires']).getTime()<Date.now()||order['Order status']==='Cancelled'))cbpError_('EXPIRED','This upload link has expired. Contact the shop.');return order;}
function cbpTrack_(body){var o=cbpAccessOrder_(body.orderId,body.token,false);return {ok:true,schema:2,id:o['Order number'],status:o['Production status'],payment:o['Payment status'],delivery:o['Delivery status'],tracking:cbpHttps_(o['Tracking URL'])?o['Tracking URL']:'',firstName:String(o.Name).split(' ')[0],updated:String(o['Created at'])};}
