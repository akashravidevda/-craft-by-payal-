  ['Shop Gift Types','Published Gift Types'].forEach(function(name){var sh=cbpSS_().getSheetByName(name);if(sh){var expected=CBP_TABLES[name];if(JSON.stringify(sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0])!==JSON.stringify(expected))cbpError_('SCHEMA','Unexpected columns in '+name);}});
