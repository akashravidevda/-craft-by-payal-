function cbpCreate_(body){
  if(!/^[a-f0-9-]{36}$/i.test(body.requestId||''))cbpError_('VALIDATION','A valid checkout request ID is required.');
  var o=cbpNormalOrder_(body.order),fingerprint=cbpHash_(JSON.stringify(o));
