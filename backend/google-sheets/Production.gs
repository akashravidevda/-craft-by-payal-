  var existing=cbpRows_('Shop Gift Types');cbpAppend_('Shop Gift Types',cbpDefaultGiftTypes_().filter(function(t){return !existing.some(function(r){return r.ID===t.id;});}).map(function(t){return {ID:t.id,Name:t.name,Enabled:t.enabled,'Sort order':t.order};}));
  var pending=JSON.parse(cbpProps_().getProperty('CBP_GIFT_TYPE_REVIEW')||'[]'),report=[];
  if(!cbpProps_().getProperty('CBP_GIFT_TAXONOMY'))cbpRows_('Shop Products').forEach(function(p){var expected=CBP_LEGACY_GIFT_TYPES[p['Product ID']],current=p.Collection;
   if(expected&&(!current||current==='miniature-frame'||current===expected)){cbpUpdate_('Shop Products',p,{Collection:expected});report.push({id:p['Product ID'],previous:current,proposed:expected,reviewed:true});}
   else{if(pending.indexOf(p['Product ID'])<0)pending.push(p['Product ID']);report.push({id:p['Product ID'],previous:current,proposed:expected||'',reviewed:false});}
  });
  cbpProps_().setProperty('CBP_GIFT_TYPE_REVIEW',JSON.stringify(pending));cbpProps_().setProperty('CBP_GIFT_TAXONOMY','2');
  if(SpreadsheetApp.newDataValidation){var ids=cbpGiftTypes_().filter(function(t){return t.enabled;}).map(function(t){return t.id;});cbpSS_().getSheetByName('Shop Products').getRange(2,CBP_TABLES['Shop Products'].indexOf('Collection')+1,2000,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(ids,true).setAllowInvalid(false).build());}
  return {ok:true,report:report,needsReview:pending};
 });
}
function confirmGiftTypeAssignment(productId,giftType){cbpOwner_();return cbpLock_(function(){
 if(!cbpGiftTypes_().some(function(t){return t.id===giftType&&t.enabled;}))cbpError_('VALIDATION','Choose an enabled Gift type.');
 var p=cbpRows_('Shop Products').find(function(r){return r['Product ID']===productId;});if(!p)cbpError_('NOT_FOUND','Product not found.');cbpUpdate_('Shop Products',p,{Collection:giftType});
 var pending=JSON.parse(cbpProps_().getProperty('CBP_GIFT_TYPE_REVIEW')||'[]').filter(function(id){return id!==productId;});cbpProps_().setProperty('CBP_GIFT_TYPE_REVIEW',JSON.stringify(pending));cbpHealth_('classification',productId,'Owner confirmed '+giftType);return {ok:true};
 });}
function getGiftTypeReview(){cbpOwner_();var pending=JSON.parse(cbpProps_().getProperty('CBP_GIFT_TYPE_REVIEW')||'[]');return {giftTypes:cbpGiftTypes_(),products:cbpRows_('Shop Products').filter(function(p){return pending.indexOf(p['Product ID'])>=0;}).map(function(p){return {id:p['Product ID'],name:p.Name,collection:p.Collection};})};}
/** Owner-only diagnostic for standalone staging projects without a spreadsheet sidebar. */
function inspectGiftTaxonomy(){
 cbpOwner_();var review=getGiftTypeReview(),products=cbpRows_('Shop Products'),counts={};
 products.forEach(function(p){if(p.State==='published')counts[p.Collection||'unclassified']=(counts[p.Collection||'unclassified']||0)+1;});
 var result={acceptOrders:cbpSettings_()['Accept orders'],giftTypes:review.giftTypes.map(function(t){return {id:t.id,enabled:t.enabled};}),needsReview:review.products,publishedCounts:counts};
 console.log(JSON.stringify(result));return result;
}
